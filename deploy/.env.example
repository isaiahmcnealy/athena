# Copy to ~/athena/.env ON THE SERVER, then chmod 600; do not commit the real file.
# Generate each password separately with: openssl rand -hex 32
# Use the hex values without URL-special characters, spaces, or quotes.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
ATHENA_WEB_DB_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
ATHENA_INGEST_DB_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# Public hostname served over HTTPS. Point its DNS record at this server before deploying.
ATHENA_DOMAIN=athena.isaiahmcnealy.com
ATHENA_PORT=8001
# Requests per client per minute for pages and the API.
RATE_LIMIT_PER_MINUTE=120
OPENALEX_API_KEY=
CONTACT_EMAIL=
# Scheduled jobs; see docs/deployment.md.
REFRESH_PER_QUERY=50
BACKUP_RETENTION_DAYS=14
# Optional off-host copy, for example s3://my-bucket/athena. Needs the AWS CLI and credentials.
BACKUP_S3_URI=
